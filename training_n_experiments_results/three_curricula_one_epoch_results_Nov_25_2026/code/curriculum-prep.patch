+++ b/scripts/benchmark/bench_pretrain.py
@@ -0,0 +1,137 @@
+"""Measure step time and peak GPU memory of V-JEPA 2.1 pretraining configs.
+
+Each (config, batch size) pair runs as a separate short training job in a
+subprocess, so an out-of-memory failure does not stop the others. Timings come
+from the per-iteration CSV log that train.py writes; the first iterations
+(cuDNN autotuning, worker start-up) are discarded.
+
+Usage (from the repository root, on a GPU node):
+    python scripts/benchmark/bench_pretrain.py --out-dir $SCRATCH/bench \
+        --keep-dir logs/bench --run configs/train_2_1/ego4d/vitb16-pretrain-256px-16f.yaml:32,64 \
+        --run configs/train_2_1/ego4d/vitl16-pretrain-256px-16f.yaml:16,24
+"""
+
+import argparse
+import csv
+import math
+import re
+import shutil
+import statistics
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import yaml
+
+
+def run_one(cfg_path, batch_size, args):
+    name = f"{Path(cfg_path).stem}-bs{batch_size}"
+    folder = Path(args.out_dir) / name
+    folder.mkdir(parents=True, exist_ok=True)
+
+    with open(cfg_path) as f:
+        cfg = yaml.safe_load(f)
+    cfg["folder"] = str(folder)
+    cfg["data"]["batch_size"] = batch_size
+    cfg["data"]["num_workers"] = args.num_workers
+    cfg["meta"]["load_checkpoint"] = False
+    cfg["meta"]["save_every_freq"] = -1
+    cfg["optimization"]["ipe"] = args.iters
+    cfg["optimization"]["epochs"] = 1
+    cfg_file = folder / "bench.yaml"
+    with open(cfg_file, "w") as f:
+        yaml.safe_dump(cfg, f)
+
+    log_file = folder / "stdout.log"
+    t0 = time.time()
+    with open(log_file, "w") as log:
+        try:
+            proc = subprocess.run(
+                [sys.executable, "-m", "app.main", "--fname", str(cfg_file), "--devices", "cuda:0"],
+                stdout=log,
+                stderr=subprocess.STDOUT,
+                timeout=args.timeout,
+            )
+            status = "ok" if proc.returncode == 0 else f"exit {proc.returncode}"
+        except subprocess.TimeoutExpired:
+            status = "timeout"
+    wall = time.time() - t0
+
+    text = log_file.read_text(errors="replace")
+    # app.main trains in a child process, so a crash can still exit with 0
+    if "OutOfMemoryError" in text or "CUDA out of memory" in text:
+        status = "OOM"
+    elif "Traceback (most recent call last)" in text:
+        status = "crash"
+    mems = [float(m) for m in re.findall(r"\[mem: ([0-9.e+]+)\]", text)]
+
+    rows = []
+    csv_log = folder / "log_r0.csv"
+    if csv_log.exists():
+        with open(csv_log) as f:
+            rows = list(csv.DictReader(f))
+    rows = rows[args.skip :]
+
+    def med(key):
+        vals = [float(r[key]) for r in rows]
+        return statistics.median(vals) if vals else float("nan")
+
+    # Keep the small logs on persistent storage right away ($SCRATCH is wiped
+    # when the job ends, including when a later run crashes the job)
+    keep = Path(args.keep_dir) / name
+    keep.mkdir(parents=True, exist_ok=True)
+    for f in (log_file, csv_log):
+        if f.exists():
+            shutil.copy(f, keep / f.name)
+    if status != "ok":
+        tail = [ln for ln in text.splitlines() if ln.strip()][-8:]
+        print(f"--- {name} {status}, last log lines:\n" + "\n".join(tail), flush=True)
+
+    def rnd(x, nd=0):
+        return None if x is None or math.isnan(x) else round(x, nd or None)
+
+    iter_ms, gpu_ms, data_ms = med("iter-time(ms)"), med("gpu-time(ms)"), med("dataload-time(ms)")
+    return {
+        "run": name,
+        "status": status,
+        "iters_timed": len(rows),
+        "peak_mem_GiB": round(max(mems) / 1024, 1) if mems else None,
+        "iter_ms": rnd(iter_ms),
+        "gpu_ms": rnd(gpu_ms),
+        "data_wait_ms": rnd(data_ms),
+        "clips_per_s_gpu": rnd(batch_size / gpu_ms * 1000, 1),
+        "clips_per_s_total": rnd(batch_size / iter_ms * 1000, 1),
+        "wall_s": round(wall),
+    }
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--run", action="append", required=True, help="config.yaml:bs1,bs2,...")
+    p.add_argument("--out-dir", required=True, help="run folders (checkpoints): use $SCRATCH")
+    p.add_argument("--keep-dir", required=True, help="persistent copy of logs and results")
+    p.add_argument("--iters", type=int, default=40)
+    p.add_argument("--skip", type=int, default=10, help="initial iterations to ignore")
+    p.add_argument("--num-workers", type=int, default=12)
+    p.add_argument("--timeout", type=int, default=300, help="seconds per run")
+    args = p.parse_args()
+
+    results = []
+    for spec in args.run:
+        cfg_path, sizes = spec.rsplit(":", 1)
+        for bs in [int(s) for s in sizes.split(",")]:
+            r = run_one(cfg_path, bs, args)
+            results.append(r)
+            print(r, flush=True)
+
+    out = Path(args.keep_dir) / "results.csv"
+    with open(out, "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=list(results[0].keys()))
+        w.writeheader()
+        w.writerows(results)
+    print(f"\nwrote {out}")
+
+
+if __name__ == "__main__":
+    main()
-- 
