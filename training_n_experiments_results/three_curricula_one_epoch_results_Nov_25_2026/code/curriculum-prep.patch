diff --git a/scripts/analysis/plot_curricula.py b/scripts/analysis/plot_curricula.py
new file mode 100644
index 0000000..62307d1
--- /dev/null
+++ b/scripts/analysis/plot_curricula.py
@@ -0,0 +1,90 @@
+"""Plot the three curriculum runs on one graph: held-out loss and training loss.
+
+Reads runs/vitb16-ego4d-{top,low,random}/{eval_r0,log_r0}.csv (rows logged twice
+after a resume are deduplicated, keeping the last) and writes a PNG.
+
+    python scripts/analysis/plot_curricula.py --out curricula_loss.png
+"""
+
+import argparse
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+import pandas as pd  # noqa: E402
+
+RUNS = "/data/asem.a.abdelaziz/gp-2027a/runs/vitb16-ego4d-{}"
+# Categorical slots 1-3 of the reference palette, in fixed order
+CURRICULA = [("top", "#2a78d6", "top (most surprising first)"),
+             ("low", "#eb6834", "low (least surprising first)"),
+             ("random", "#1baf7a", "random")]
+INK, INK2, GRID, SURFACE = "#0b0b0b", "#52514e", "#e4e3df", "#fcfcfb"
+
+
+def style(ax, title, ylabel):
+    ax.set_facecolor(SURFACE)
+    ax.set_title(title, loc="left", color=INK, fontsize=12, fontweight="bold")
+    ax.set_xlabel("clips seen (thousands)", color=INK2)
+    ax.set_ylabel(ylabel, color=INK2)
+    ax.grid(axis="y", color=GRID, linewidth=0.8)
+    ax.tick_params(colors=INK2, length=0)
+    for side in ("top", "right", "left"):
+        ax.spines[side].set_visible(False)
+    ax.spines["bottom"].set_color(INK2)
+
+
+def label_ends(ax, ends):
+    # Direct labels at the right end of each line, nudged apart so they never overlap
+    ends = sorted(ends, key=lambda e: e[1])
+    lo, hi = ax.get_ylim()
+    gap = (hi - lo) * 0.045
+    placed = []
+    for x, y, text in ends:
+        if placed and y - placed[-1] < gap:
+            y = placed[-1] + gap
+        placed.append(y)
+        ax.annotate(text, (x, y), xytext=(6, 0), textcoords="offset points",
+                    va="center", color=INK, fontsize=9)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out", required=True)
+    p.add_argument("--smooth-clips", type=int, default=5000, help="training-loss moving average window")
+    args = p.parse_args()
+
+    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4.8), facecolor=SURFACE)
+    ends1, ends2 = [], []
+    for name, color, label in CURRICULA:
+        ev = pd.read_csv(f"{RUNS.format(name)}/eval_r0.csv").drop_duplicates("clips_seen", keep="last")
+        x = ev.clips_seen / 1000
+        ax1.plot(x, ev.loss_pred, color=color, linewidth=2, marker="o", markersize=4, label=label)
+        ends1.append((x.iloc[-1], ev.loss_pred.iloc[-1], f"{name} {ev.loss_pred.iloc[-1]:.3f}"))
+
+        log = pd.read_csv(f"{RUNS.format(name)}/log_r0.csv").drop_duplicates("step", keep="last")
+        clips = (log.last_row + 1) / 1000
+        window = max(1, args.smooth_clips // int(log.last_row.iloc[0] - log.first_row.iloc[0] + 1))
+        smooth = log.loss_pred.rolling(window, min_periods=window).mean()
+        ax2.plot(clips, smooth, color=color, linewidth=2, label=label)
+        ends2.append((clips.iloc[-1], smooth.iloc[-1], name))
+
+    style(ax1, "Held-out loss (1,000 clips, 30 unseen videos)", "prediction loss")
+    style(ax2, f"Training loss ({args.smooth_clips // 1000}k-clip moving average)", "prediction loss")
+    ax1.set_ylim(0.46, 0.62)  # the step-0 value (0.858) is off the top so the differences stay readable
+    ax1.text(0.98, 0.97, "step 0: all runs at 0.858 (off scale)", transform=ax1.transAxes,
+             ha="right", va="top", color=INK2, fontsize=8)
+    for ax, ends in ((ax1, ends1), (ax2, ends2)):
+        ax.set_xlim(0, 235)
+        label_ends(ax, ends)
+    fig.legend(*ax1.get_legend_handles_labels(), loc="lower center", frameon=False, ncol=3,
+               fontsize=9, labelcolor=INK)
+    fig.suptitle("V-JEPA 2.1 ViT-B/16 on Ego4D: one pass per curriculum (batch 16, LR 2e-4)",
+                 x=0.06, ha="left", color=INK, fontsize=13)
