+++ b/tests/datasets/test_resumable_sequential_sampler.py
@@ -0,0 +1,38 @@
+import unittest
+
+from src.datasets.video_dataset import ResumableSequentialSampler
+
+
+class TestResumableSequentialSampler(unittest.TestCase):
+    def rows(self, n, world_size, start=0):
+        per_rank = []
+        for rank in range(world_size):
+            s = ResumableSequentialSampler(range(n), num_replicas=world_size, rank=rank)
+            s.set_start_index(start)
+            per_rank.append(list(s))
+            self.assertEqual(len(s), len(per_rank[-1]))
+        return per_rank
+
+    def test_single_rank_keeps_order(self):
+        self.assertEqual(self.rows(10, 1), [list(range(10))])
+
+    def test_ranks_interleave_without_padding(self):
+        # 10 rows over 3 ranks: the last row is dropped, never wrapped to row 0
+        self.assertEqual(self.rows(10, 3), [[0, 3, 6], [1, 4, 7], [2, 5, 8]])
+
+    def test_resume_continues_where_it_stopped(self):
+        self.assertEqual(self.rows(10, 1, start=7), [[7, 8, 9]])
+        self.assertEqual(self.rows(10, 2, start=4), [[4, 6, 8], [5, 7, 9]])
+
+    def test_resume_after_end_is_empty(self):
+        self.assertEqual(self.rows(10, 1, start=12), [[]])
+
+    def test_order_does_not_depend_on_epoch(self):
+        s = ResumableSequentialSampler(range(5))
+        first = list(s)
+        s.set_epoch(3)
+        self.assertEqual(list(s), first)
+
+
+if __name__ == "__main__":
+    unittest.main()
