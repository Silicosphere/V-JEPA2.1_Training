From 29bb7a278d78309120b9020c9b2b28b7a288575d Mon Sep 17 00:00:00 2001
From: Mohamed Gad <mohamedgad.tg@gmail.com>
Date: Sat, 21 Nov 2026 20:40:20 +0000
Subject: [PATCH 07/13] Add a script that filters degenerate clips and carves
 out a whole-video held-out set

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/data/make_curriculum_split.py | 138 ++++++++++++++++++++++++++
 1 file changed, 138 insertions(+)
 create mode 100644 scripts/data/make_curriculum_split.py

diff --git a/scripts/data/make_curriculum_split.py b/scripts/data/make_curriculum_split.py
new file mode 100644
index 0000000..441c8ab
--- /dev/null
+++ b/scripts/data/make_curriculum_split.py
@@ -0,0 +1,138 @@
+"""Filter the curriculum lists and carve out a whole-video held-out set.
+
+Reads the three curriculum lists (same clips, different order) and the output
+of scan_clips.py, then writes to a NEW folder (the originals are not touched):
+
+    <name>.csv            each input list minus dropped and held-out clips,
+                          lines copied verbatim and in their original order
+    heldout_eval.csv      --eval-clips clips from the held-out videos, evenly
+                          spaced over the surprise ranking
+    heldout_videos.txt    the held-out video ids (all their clips are removed
+                          from training)
+    removed_clips.csv     path, reason (black | dim | heldout)
+    summary.json
+
+Held-out videos are drawn one per stratum of median surprise rank (rank =
+position in --rank-list), among videos with no dropped clip and a clip count
+in --video-size, so the held-out clips cover the whole surprise range.
+
+Usage:
+    python scripts/data/make_curriculum_split.py \
+        --lists-dir /data/.../ego4d_lists --scan scan1.csv scan2.csv \
+        --out-dir /data/.../ego4d_lists_filtered
+"""
+
+import argparse
+import json
+import os
+
+import numpy as np
+import pandas as pd
+
+LISTS = ["ego4d_top.csv", "ego4d_low.csv", "ego4d_random.csv"]
+
+
+def read_list(path):
+    with open(path) as f:
+        lines = [line.rstrip("\n") for line in f if line.strip()]
+    return lines, [line.split()[0] for line in lines]
+
+
+def video_of(clip_path):
+    return clip_path.split("::", 1)[1].split("/")[0]
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--lists-dir", required=True)
+    p.add_argument("--lists", nargs="+", default=LISTS)
+    p.add_argument("--rank-list", default="ego4d_top.csv", help="list whose order defines surprise rank")
+    p.add_argument("--scan", nargs="+", required=True, help="scan_clips.py outputs")
+    p.add_argument("--out-dir", required=True)
+    p.add_argument("--black-std", type=float, default=0.0, help="drop clips with pixel std <= this")
+    p.add_argument("--dim-std", type=float, default=None, help="also drop clips with pixel std <= this")
+    p.add_argument("--heldout-videos", type=int, default=30)
+    p.add_argument("--video-size", type=int, nargs=2, default=[30, 120], help="min/max clips per held-out video")
+    p.add_argument("--eval-clips", type=int, default=1000)
+    p.add_argument("--seed", type=int, default=0)
+    args = p.parse_args()
+
+    if os.path.exists(args.out_dir) and os.listdir(args.out_dir):
+        raise SystemExit(f"{args.out_dir} is not empty; refusing to overwrite")
+
+    lists = {name: read_list(os.path.join(args.lists_dir, name)) for name in args.lists}
+    paths = lists[args.rank_list][1]
+    n = len(paths)
+    for name, (_, ps) in lists.items():
+        if len(ps) != n or set(ps) != set(paths) or len(set(ps)) != n:
+            raise SystemExit(f"{name} does not hold the same {n} unique clips as {args.rank_list}")
+
+    scan = pd.concat([pd.read_csv(s) for s in args.scan]).dropna(subset=["motion"])
+    scan = scan.drop_duplicates("path", keep="last").set_index("path")
+    missing = set(paths) - set(scan.index)
+    if missing:
+        raise SystemExit(f"{len(missing)} clips were never scanned, e.g. {next(iter(missing))}")
+    if (scan.ok != 1).any():
+        raise SystemExit(f"{int((scan.ok != 1).sum())} clips failed to decode; fix them first")
+
+    clips = pd.DataFrame({"path": paths, "rank": np.arange(n)})
+    clips["video"] = clips.path.map(video_of)
+    clips["std"] = clips.path.map(scan["std"])
+    clips["reason"] = ""
+    if args.dim_std is not None:
+        clips.loc[clips["std"] <= args.dim_std, "reason"] = "dim"
+    clips.loc[clips["std"] <= args.black_std, "reason"] = "black"
+
+    # Held-out videos: one per stratum of median rank, among clean mid-size videos
+    per_video = clips.groupby("video").agg(n=("rank", "size"), median_rank=("rank", "median"),
+                                           dropped=("reason", lambda r: (r != "").sum()))
+    lo, hi = args.video_size
+    eligible = per_video[(per_video.dropped == 0) & per_video.n.between(lo, hi)].sort_values("median_rank")
+    if len(eligible) < args.heldout_videos:
+        raise SystemExit(f"only {len(eligible)} eligible videos")
+    rng = np.random.default_rng(args.seed)
+    strata = np.array_split(eligible.index.to_numpy(), args.heldout_videos)
+    heldout = sorted(str(rng.choice(s)) for s in strata)
+    clips.loc[clips.video.isin(heldout), "reason"] = "heldout"
+
+    held = clips[clips.reason == "heldout"].sort_values("rank")
+    if len(held) < args.eval_clips:
+        raise SystemExit(f"held-out videos have {len(held)} clips < {args.eval_clips}")
+    take = np.unique(np.linspace(0, len(held) - 1, args.eval_clips).round().astype(int))
+    eval_paths = set(held.path.iloc[take])
+
+    os.makedirs(args.out_dir, exist_ok=True)
+    removed = set(clips.path[clips.reason != ""])
+    kept = {}
+    for name, (lines, ps) in lists.items():
+        out = [line for line, pth in zip(lines, ps) if pth not in removed]
+        kept[name] = [line.split()[0] for line in out]
+        with open(os.path.join(args.out_dir, name), "w") as f:
+            f.write("\n".join(out) + "\n")
+    assert all(set(k) == set(kept[args.rank_list]) for k in kept.values())
+
+    rank_lines = dict(zip(paths, lists[args.rank_list][0]))
+    with open(os.path.join(args.out_dir, "heldout_eval.csv"), "w") as f:
+        f.write("\n".join(rank_lines[pth] for pth in held.path if pth in eval_paths) + "\n")
+    with open(os.path.join(args.out_dir, "heldout_videos.txt"), "w") as f:
+        f.write("\n".join(heldout) + "\n")
+    clips[clips.reason != ""][["path", "reason"]].to_csv(os.path.join(args.out_dir, "removed_clips.csv"), index=False)
+
+    summary = dict(
+        args=vars(args),
+        input_clips=n,
+        removed={r: int((clips.reason == r).sum()) for r in ["black", "dim", "heldout"]},
+        train_clips=len(kept[args.rank_list]),
+        heldout_videos=len(heldout),
+        heldout_clips=len(held),
+        eval_clips=len(eval_paths),
+        eval_rank_fraction_quantiles={q: round(float(held.set_index("path").loc[list(eval_paths), "rank"].quantile(q)) / n, 3)
+                                      for q in [0, 0.25, 0.5, 0.75, 1]},
+    )
+    with open(os.path.join(args.out_dir, "summary.json"), "w") as f:
+        json.dump(summary, f, indent=2)
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
-- 
