+class ResumableSequentialSampler(torch.utils.data.Sampler):
+    """Yield dataset rows in their original order, starting at a given row.
+
+    Rows are interleaved across ranks: rank r gets rows start + r,
+    start + r + world_size, ... so the global batch at each step is a
+    contiguous block of rows. Unlike DistributedSampler(shuffle=False), the
+    tail is truncated instead of padded by wrapping back to the first rows,
+    so no row is ever seen twice.
+
+    set_start_index(n) skips the first n rows (counted over all ranks), which
+    is how training resumes at the exact point of the curriculum.
+    """
+
+    def __init__(self, dataset, num_replicas=1, rank=0):
+        self.num_rows = len(dataset)
+        self.num_replicas = num_replicas
+        self.rank = rank
+        self.start_index = 0
+
+    def set_start_index(self, start_index):
+        self.start_index = int(start_index)
+
+    def set_epoch(self, epoch):
+        # The order never depends on the epoch
+        pass
+
+    def __len__(self):
+        remaining = max(self.num_rows - self.start_index, 0)
+        return remaining // self.num_replicas
+
+    def __iter__(self):
+        first = self.start_index + self.rank
+        stop = self.start_index + len(self) * self.num_replicas
+        return iter(range(first, stop, self.num_replicas))
+
+
