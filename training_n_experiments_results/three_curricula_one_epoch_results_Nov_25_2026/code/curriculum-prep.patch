From 66b051bbab5806e31724af6f124e15c9429c3741 Mon Sep 17 00:00:00 2001
From: Mohamed Gad <mohamedgad.tg@gmail.com>
Date: Sat, 21 Nov 2026 17:50:39 +0000
Subject: [PATCH 05/13] Add a clip scanner to validate all curriculum clips
 before training

Decodes every row of a list and records pixel mean, std and motion, so
unreadable clips (which would stop a strict-order run) and black or frozen
clips can be found. Supports row ranges and resuming across jobs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/data/scan_clips.py     | 107 +++++++++++++++++++++++++++++++++
 scripts/data/scan_clips.sbatch |  19 ++++++
 2 files changed, 126 insertions(+)
 create mode 100644 scripts/data/scan_clips.py
 create mode 100644 scripts/data/scan_clips.sbatch

diff --git a/scripts/data/scan_clips.py b/scripts/data/scan_clips.py
new file mode 100644
index 0000000..d50a07d
--- /dev/null
+++ b/scripts/data/scan_clips.py
@@ -0,0 +1,107 @@
+"""Decode every clip of a V-JEPA CSV list and record basic pixel statistics.
+
+Serves two purposes before a strict-order training run:
+  - every row must decode (a row that fails stops the run, it is never skipped)
+  - find degenerate clips (black, uniform or frozen frames) to filter out
+
+For each row it decodes N evenly spaced frames and writes:
+    row, path, ok, error, frames, fps, height, width,
+    mean (pixel mean), std (pixel std over the frames), motion (mean abs
+    difference between consecutive sampled frames)
+
+Usage (CPU only; I/O bound on NFS, so use many processes):
+    python scripts/data/scan_clips.py LIST.csv --out scan.csv --procs 20
+Split the list over jobs with --start/--stop (row numbers); --resume skips rows
+already in --out (e.g. after a job hit its time limit) and appends to it.
+"""
+
+import argparse
+import csv
+import io
+import os
+import time
+from multiprocessing import Pool
+
+import h5py
+import numpy as np
+from decord import VideoReader, cpu
+
+FIELDS = ["row", "path", "ok", "error", "frames", "fps", "height", "width", "mean", "std", "motion"]
+N_FRAMES = 8
+_files = {}
+
+
+def _h5(path):
+    # Keep one handle per HDF5 file in each worker process
+    if path not in _files:
+        _files[path] = h5py.File(path, "r")
+    return _files[path]
+
+
+def scan(item):
+    row, path = item
+    out = dict(row=row, path=path, ok=0, error="")
+    try:
+        h5_path, key = path.split("::", 1)
+        data = _h5(h5_path)[key][()].tobytes()
+        vr = VideoReader(io.BytesIO(data), num_threads=1, ctx=cpu(0))
+        n = len(vr)
+        x = vr.get_batch(list(np.linspace(0, n - 1, N_FRAMES).astype(int))).asnumpy()
+        x = x.astype(np.float32)
+        out.update(
+            ok=1,
+            frames=n,
+            fps=round(vr.get_avg_fps(), 3),
+            height=x.shape[1],
+            width=x.shape[2],
+            mean=round(float(x.mean()), 3),
+            std=round(float(x.std()), 3),
+            motion=round(float(np.abs(np.diff(x, axis=0)).mean()), 3),
+        )
+    except Exception as e:  # report every failure, keep scanning
+        out["error"] = f"{type(e).__name__}: {e}"[:300]
+    return out
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("list_csv")
+    p.add_argument("--out", required=True)
+    p.add_argument("--procs", type=int, default=16)
+    p.add_argument("--start", type=int, default=0, help="first row to scan")
+    p.add_argument("--stop", type=int, default=None, help="row to stop before")
+    p.add_argument("--resume", action="store_true", help="skip rows already in --out")
+    args = p.parse_args()
+
+    with open(args.list_csv) as f:
+        items = [(i, line.split()[0]) for i, line in enumerate(f) if line.strip()]
+    items = items[args.start : args.stop]
+
+    done = set()
+    resume = args.resume and os.path.exists(args.out)
+    if resume:
+        with open(args.out) as f:
+            # A job killed at its time limit can leave a truncated last line
+            done = {int(r["row"]) for r in csv.DictReader(f) if r.get("motion") is not None}
+        items = [it for it in items if it[0] not in done]
+        print(f"resuming: {len(done)} rows already scanned, {len(items)} to go", flush=True)
+
+    t0, failed = time.time(), 0
+    with open(args.out, "a" if resume else "w", newline="") as f, Pool(args.procs) as pool:
+        w = csv.DictWriter(f, fieldnames=FIELDS)
+        if not resume:
+            w.writeheader()
+        for k, r in enumerate(pool.imap(scan, items, chunksize=16), 1):
+            w.writerow(r)
+            if k % 500 == 0:
+                f.flush()
+            failed += r["ok"] == 0
+            if k % 5000 == 0:
+                rate = k / (time.time() - t0)
+                print(f"{k}/{len(items)} rows, {failed} failed, {rate:.0f} rows/s, "
+                      f"eta {(len(items) - k) / rate / 60:.0f} min", flush=True)
+    print(f"done: {len(items)} rows, {failed} failed, {(time.time() - t0) / 60:.1f} min")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/data/scan_clips.sbatch b/scripts/data/scan_clips.sbatch
new file mode 100644
index 0000000..e48e4b6
--- /dev/null
+++ b/scripts/data/scan_clips.sbatch
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Decode all 217k curriculum clips once: check they all load and record pixel
+# statistics to find black / frozen clips. CPU only (~15 CPU-hours, ~1 h on 22
+# cores). The three curriculum CSVs hold the same clips, so one list is enough.
+# Submit from the repository root:  sbatch scripts/data/scan_clips.sbatch
+#SBATCH --job-name=scan-clips
+#SBATCH --partition=gpu
+#SBATCH --nodelist=gpu-08
+#SBATCH --cpus-per-task=22
+#SBATCH --mem=12G
+#SBATCH --time=02:00:00
+#SBATCH --output=logs/scan-clips-%j.out
+
+set -euo pipefail
+module load FFmpeg/7.0.2-GCCcore-13.3.0
+export PYTHONPATH="$PWD"
+/data/asem.a.abdelaziz/gp-2027a/myenv/bin/python scripts/data/scan_clips.py \
+    /data/asem.a.abdelaziz/gp-2027a/ego4d_lists/ego4d_random.csv \
+    --out "logs/clip-scan-$SLURM_JOB_ID.csv" --procs 22
