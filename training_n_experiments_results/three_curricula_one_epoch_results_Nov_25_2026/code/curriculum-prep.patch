From 08b09b5bcdb09574d7735404aa3986c3668042c2 Mon Sep 17 00:00:00 2001
From: Mohamed Gad <mohamedgad.tg@gmail.com>
Date: Sat, 21 Nov 2026 17:35:55 +0000
Subject: [PATCH 01/13] Fix compute_mask_distance at batch size 1 and vectorize
 it

The context-loss distance weights were computed with one cdist per context
token in a Python loop, then .squeeze()d, which dropped the batch dimension
when the batch size is 1 and crashed the loss. Compute all distances in one
cdist call instead: same values (differences within float32 rounding of the
old mm-based cdist path) and a much smaller fixed cost per step.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/vjepa_2_1/models/utils/masks_dist.py | 30 +++++++++++-------------
 1 file changed, 14 insertions(+), 16 deletions(-)

diff --git a/app/vjepa_2_1/models/utils/masks_dist.py b/app/vjepa_2_1/models/utils/masks_dist.py
index 216f573..6808fdd 100644
--- a/app/vjepa_2_1/models/utils/masks_dist.py
+++ b/app/vjepa_2_1/models/utils/masks_dist.py
@@ -56,22 +56,20 @@ def compute_mask_distance(masks_pred, masks_enc, grid_size, offset_context_loss)
                 masks_pred_ij, grid_size=grid_size
             )  # (BS, N_pred)
             pred = torch.stack([d_pred, h_pred, w_pred], dim=-1)  # (BS, N_pred, 3)
-            enc_distances = []
-            for enc_token in range(N_enc_tokens):
-                enc_position = torch.stack(
-                    [d_enc[:, enc_token], h_enc[:, enc_token], w_enc[:, enc_token]],
-                    dim=-1,
-                ).unsqueeze(
-                    1
-                )  # (BS, 1, 3)
-                dist = torch.cdist(enc_position, pred, p=2)  # (BS, N_enc)
-                dmin, argmin = dist.min(dim=-1)
-                if offset_context_loss:
-                    coeff = grid_size // 16  # Which is the default value of grid_size
-                    dmin = dmin * (1.0 / coeff)
-                dmin = dmin**0.5  # We want that it decreases less agressive
-                enc_distances.append(dmin)
-            enc_distances = torch.stack(enc_distances, dim=-1).squeeze()  # (BS, N_enc)
+            enc = torch.stack([d_enc, h_enc, w_enc], dim=-1)  # (BS, N_enc, 3)
+            # Distance from every context token to its nearest predicted token, in
+            # one call (this used to loop over the N_enc tokens one cdist at a
+            # time, a large fixed cost per step, and squeezed away the batch dim
+            # when BS == 1). Exact distances, as in the per-token version.
+            dist = torch.cdist(
+                enc, pred, p=2, compute_mode="donot_use_mm_for_euclid_dist"
+            )  # (BS, N_enc, N_pred)
+            enc_distances = dist.min(dim=-1).values  # (BS, N_enc)
+            if offset_context_loss:
+                coeff = grid_size // 16  # Which is the default value of grid_size
+                enc_distances = enc_distances * (1.0 / coeff)
+            enc_distances = enc_distances**0.5  # We want that it decreases less agressive
+            assert enc_distances.shape[1] == N_enc_tokens
             row_distances.append(enc_distances)
         distances.append(row_distances)
     return distances
