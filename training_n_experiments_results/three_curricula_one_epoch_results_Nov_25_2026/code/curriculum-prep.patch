diff --git a/src/utils/seeding.py b/src/utils/seeding.py
new file mode 100644
index 0000000..3146964
--- /dev/null
+++ b/src/utils/seeding.py
@@ -0,0 +1,22 @@
+import hashlib
+import random
+
+import numpy as np
+import torch
+
+
+def stable_seed(*parts):
+    """63-bit seed derived from the given values, identical in every process.
+
+    Python's hash() is salted per process, so it cannot be used to give the same
+    clip the same random draws in different runs or DataLoader workers.
+    """
+    digest = hashlib.sha256(":".join(str(p) for p in parts).encode()).digest()
+    return int.from_bytes(digest[:8], "little") >> 1
+
+
+def seed_all(seed):
+    """Seed the global python, numpy and torch generators of this process."""
+    random.seed(seed)
+    np.random.seed(seed % 2**32)
+    torch.manual_seed(seed)
diff --git a/tests/check_rng_determinism.py b/tests/check_rng_determinism.py
new file mode 100644
index 0000000..227869d
--- /dev/null
+++ b/tests/check_rng_determinism.py
@@ -0,0 +1,113 @@
+"""Check that per-clip / per-step seeding makes data order the only difference.
+
+Takes the first N rows of a curriculum CSV, writes them in their original and in
+reversed order, and loads both through the real V-JEPA 2.1 transforms and mask
+collator with data.per_clip_rng enabled. It checks that:
+  1. a clip gets the same pixels (window, crop, flip) in both orders,
+  2. a step gets the same masks in both orders,
+  3. neither depends on the number of DataLoader workers,
+and, as a sanity check, that without seeding the same clip is augmented
+differently in the two orders (so the check can actually detect a difference).
+
+Decodes real clips, so it needs access to the HDF5 files (runs on CPU).
+
+Usage:
+    PYTHONPATH=. python tests/check_rng_determinism.py \
+        --csv /data/asem.a.abdelaziz/gp-2027a/ego4d_lists/ego4d_top.csv
+"""
+
+import argparse
+import sys
+import tempfile
+from pathlib import Path
+
+import torch
+
+from app.vjepa_2_1.transforms import make_transforms
+from src.datasets.video_dataset import make_videodataset
+from src.masks.multiseq_multiblock3d import MaskCollator
+
+MASKS = [
+    dict(aspect_ratio=[0.75, 1.5], num_blocks=8, spatial_scale=[0.15, 0.15], temporal_scale=[1.0, 1.0]),
+    dict(aspect_ratio=[0.75, 1.5], num_blocks=2, spatial_scale=[0.7, 0.7], temporal_scale=[1.0, 1.0]),
+]
+
+
+def load(csv, seed, num_workers, batch_size):
+    """Return ({clip path: pixels}, [masks of each step])."""
+    transform = make_transforms(
+        random_horizontal_flip=True,
+        random_resize_aspect_ratio=[0.75, 1.35],
+        random_resize_scale=[0.3, 1.0],
+        crop_size=256,
+    )
+    collator = MaskCollator(MASKS, dataset_fpcs=[16], crop_size=256, patch_size=16, tubelet_size=2, seed=seed)
+    dataset, loader, _ = make_videodataset(
+        data_paths=[csv],
+        batch_size=batch_size,
+        frames_per_clip=16,
+        dataset_fpcs=[16],
+        frame_step=None,
+        fps=4,
+        transform=transform,
+        collator=collator,
+        num_workers=num_workers,
+        persistent_workers=False,
+        pin_mem=False,
+        shuffle=False,
+        rng_seed=seed,
+    )
+    pixels, masks = {}, []
+    for batch in loader:
+        (clips, _, rows, _), masks_enc, masks_pred = batch[0]
+        for x, r in zip(clips[0], rows.tolist()):
+            pixels[dataset.samples[r]] = x
+        masks.append([m.clone() for m in masks_enc + masks_pred])
+    return pixels, masks
+
+
+def same_masks(a, b):
+    return len(a) == len(b) and all(
+        len(x) == len(y) and all(torch.equal(u, v) for u, v in zip(x, y)) for x, y in zip(a, b)
+    )
+
+
+def same_pixels(a, b):
+    return a.keys() == b.keys() and all(torch.equal(a[k], b[k]) for k in a)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--csv", required=True)
+    p.add_argument("--rows", type=int, default=8)
+    p.add_argument("--batch-size", type=int, default=4)
+    p.add_argument("--seed", type=int, default=239)
+    args = p.parse_args()
+
+    lines = Path(args.csv).read_text().splitlines()[: args.rows]
+    tmp = Path(tempfile.mkdtemp())
+    fwd, rev = tmp / "forward.csv", tmp / "reversed.csv"
+    fwd.write_text("\n".join(lines) + "\n")
+    rev.write_text("\n".join(reversed(lines)) + "\n")
+
+    px_fwd, mk_fwd = load(str(fwd), args.seed, num_workers=2, batch_size=args.batch_size)
+    px_rev, mk_rev = load(str(rev), args.seed, num_workers=2, batch_size=args.batch_size)
+    px_w0, mk_w0 = load(str(fwd), args.seed, num_workers=0, batch_size=args.batch_size)
+    px_nos_fwd, _ = load(str(fwd), None, num_workers=2, batch_size=args.batch_size)
+    px_nos_rev, _ = load(str(rev), None, num_workers=2, batch_size=args.batch_size)
+
+    checks = {
+        "same clip -> same pixels across orders": same_pixels(px_fwd, px_rev),
+        "same step -> same masks across orders": same_masks(mk_fwd, mk_rev),
+        "pixels independent of num_workers": same_pixels(px_fwd, px_w0),
+        "masks independent of num_workers": same_masks(mk_fwd, mk_w0),
+        "sanity: without seeding, orders differ": not same_pixels(px_nos_fwd, px_nos_rev),
+    }
+    for name, ok in checks.items():
+        print(f"{'ok  ' if ok else 'FAIL'} {name}")
+    print(f"({len(px_fwd)} clips, {len(mk_fwd)} steps)")
+    sys.exit(0 if all(checks.values()) else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/datasets/test_resumable_sequential_sampler.py b/tests/datasets/test_resumable_sequential_sampler.py
