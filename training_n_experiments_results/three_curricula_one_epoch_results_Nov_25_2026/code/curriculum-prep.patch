@@ -0,0 +1,48 @@
+#!/bin/bash
+# One V-JEPA 2.1 ViT-B pretraining pass over one curriculum list, in CSV order.
+#   sbatch [GPU options] scripts/train/curriculum.sbatch top|low|random
+# Writes to runs/vitb16-ego4d-<curriculum>/ on /data (not $SCRATCH) so that a
+# job stopped by its time limit or a node failure resumes exactly where its
+# last checkpoint left off: resubmit the same command. Checkpoints every 10,000
+# clips. Set WORKERS to change the number of loader workers (it does not change
+# what is trained on: clip crops and masks are seeded per clip and per step).
+# Placement used (submit from the repository root):
+#   sbatch --nodelist=gpu-06 --gres=gpu:rtx5090:1   --cpus-per-task=16 --mem=48G --export=ALL,WORKERS=12 scripts/train/curriculum.sbatch top
+#   sbatch --nodelist=gpu-01 --gres=gpu:rtx5070ti:1 scripts/train/curriculum.sbatch random
+#   then low on gpu-06 like top
+#SBATCH --job-name=vjepa-curriculum
+#SBATCH --partition=gpu
+#SBATCH --cpus-per-task=10
+#SBATCH --mem=27G
+#SBATCH --time=1-00:00:00
+#SBATCH --output=logs/curriculum-%x-%j.out
+
+set -euo pipefail
+CURRICULUM="${1:?usage: sbatch curriculum.sbatch top|low|random}"
+case "$CURRICULUM" in top|low|random) ;; *) echo "unknown curriculum $CURRICULUM"; exit 1 ;; esac
+module load FFmpeg/7.0.2-GCCcore-13.3.0
+export PYTHONPATH="$PWD" PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
+PY=/data/asem.a.abdelaziz/gp-2027a/myenv/bin/python
+BASE=configs/train_2_1/ego4d/vitb16-pretrain-256px-16f.yaml
+LIST=/data/asem.a.abdelaziz/gp-2027a/ego4d_lists_filtered/ego4d_$CURRICULUM.csv
+RUN=/data/asem.a.abdelaziz/gp-2027a/runs/vitb16-ego4d-$CURRICULUM
+for _ in 1 2 3; do mkdir -p "$RUN" 2>/dev/null && break; sleep 2; done
+
+echo "curriculum $CURRICULUM on $(hostname): $(nvidia-smi --query-gpu=name --format=csv,noheader)"
+echo "commit $(git -c safe.directory='*' rev-parse --short HEAD) $(git -c safe.directory='*' status --porcelain | grep -q . && echo '(uncommitted changes)')"
+$PY - "$BASE" "$LIST" "$RUN" "${WORKERS:-}" <<'EOF'
+import sys, yaml
+base, lst, run, workers = sys.argv[1:]
+c = yaml.safe_load(open(base))
+c["data"]["datasets"] = [lst]
+c["folder"] = run
+if workers:
+    c["data"]["num_workers"] = int(workers)
+yaml.safe_dump(c, open(f"{run}/config.yaml", "w"), sort_keys=False)
+EOF
+
+LOG="$RUN/train-$SLURM_JOB_ID.log"
+$PY -m app.main --fname "$RUN/config.yaml" --devices cuda:0 > "$LOG" 2>&1 || true
+grep -hE "starting at row|exhausted|held-out" "$LOG" | tail -n 5
+# app.main runs training in a child process and exits 0 even when it crashed
+if grep -q Traceback "$LOG"; then echo "CRASHED: see $LOG"; exit 1; fi
-- 
