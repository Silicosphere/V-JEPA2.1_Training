From b4bb3abe87622513d04858e1178bc1f68444125c Mon Sep 17 00:00:00 2001
From: Mohamed Gad <mohamedgad.tg@gmail.com>
Date: Mon, 23 Nov 2026 08:14:09 +0000
Subject: [PATCH 09/13] Add an LR x batch-size sweep on the first 40k clips of
 the random list

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/sweep/make_config.py | 65 ++++++++++++++++++++++++++++++++++++
 scripts/sweep/sweep.sbatch   | 43 ++++++++++++++++++++++++
 2 files changed, 108 insertions(+)
 create mode 100644 scripts/sweep/make_config.py
 create mode 100755 scripts/sweep/sweep.sbatch

diff --git a/scripts/sweep/make_config.py b/scripts/sweep/make_config.py
new file mode 100644
index 0000000..fd0c029
--- /dev/null
+++ b/scripts/sweep/make_config.py
@@ -0,0 +1,65 @@
+"""Write one sweep config: the ViT-B Ego4D config at a given batch size and LR.
+
+Every run trains on the first --clips clips of the random list (in CSV order)
+and is evaluated on the same 1,000 held-out clips, so runs compare by
+held-out loss against clips seen. All schedules are in clips, so they mean
+the same at every batch size:
+    warmup_clips       LR warmup from lr/6 to lr (upstream ratio 1e-4 -> 6e-4)
+    ema_horizon_clips  target-encoder EMA, m = 1 - batch / horizon
+    lambda_*_clips     context-loss ramp
+The LR is constant after warmup (upstream default: final_lr == lr).
+
+Usage:
+    python scripts/sweep/make_config.py --batch 16 --lr 1e-4 --folder DIR --out cfg.yaml
+"""
+
+import argparse
+
+import yaml
+
+BASE = "configs/train_2_1/ego4d/vitb16-pretrain-256px-16f.yaml"
+DATA = "/data/asem.a.abdelaziz/gp-2027a/ego4d_lists_filtered/ego4d_random.csv"
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--batch", type=int, required=True)
+    p.add_argument("--lr", type=float, required=True)
+    p.add_argument("--folder", required=True)
+    p.add_argument("--out", required=True)
+    p.add_argument("--base", default=BASE)
+    p.add_argument("--clips", type=int, default=40000, help="clips to train on (~20% of a pass)")
+    p.add_argument("--epochs", type=int, default=4, help="checkpoints during the run")
+    p.add_argument("--warmup-clips", type=int, default=8000)
+    p.add_argument("--ema-horizon-clips", type=int, default=21333, help="21333 = upstream m 0.99925 at batch 16")
+    p.add_argument("--lambda-clips", type=int, nargs=2, default=[10000, 20000])
+    p.add_argument("--eval-every-clips", type=int, default=10000)
+    args = p.parse_args()
+
+    per_epoch = args.clips // args.epochs
+    if per_epoch % args.batch:
+        raise SystemExit(f"--clips/--epochs = {per_epoch} is not a multiple of batch {args.batch}")
+
+    with open(args.base) as f:
+        c = yaml.safe_load(f)
+    c["folder"] = args.folder
+    c["data"]["datasets"] = [DATA]
+    c["data"]["batch_size"] = args.batch
+    c["eval"]["every_clips"] = args.eval_every_clips
+    c["model"]["lambda_start_clips"], c["model"]["lambda_end_clips"] = args.lambda_clips
+    o = c["optimization"]
+    o.update(
+        epochs=args.epochs,
+        ipe=per_epoch // args.batch,
+        lr=args.lr,
+        start_lr=args.lr / 6,
+        final_lr=args.lr,
+        warmup_clips=args.warmup_clips,
+        ema_horizon_clips=args.ema_horizon_clips,
+    )
+    with open(args.out, "w") as f:
+        yaml.safe_dump(c, f, sort_keys=False)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/sweep/sweep.sbatch b/scripts/sweep/sweep.sbatch
new file mode 100755
index 0000000..e52de2c
--- /dev/null
+++ b/scripts/sweep/sweep.sbatch
@@ -0,0 +1,43 @@
+#!/bin/bash
+# LR x batch-size sweep for ViT-B on the first 40k clips of the random list.
+# Runs the given batch:lr pairs one after another. Each run trains on node-local
+# $SCRATCH (checkpoints stay there) and copies its logs to
+# runs/sweep/bs<B>-lr<LR>/ when it ends. A run whose final evaluation is already
+# there is skipped, so resubmitting after a time limit continues the sweep (an
+# unfinished run restarts from its beginning).
+# Submit from the repository root, e.g.:
+#   sbatch --nodelist=gpu-01 --gres=gpu:rtx5070ti:1 scripts/sweep/sweep.sbatch 16:3e-5 16:1e-4 16:3e-4
+#SBATCH --job-name=vjepa-sweep
+#SBATCH --partition=gpu
+#SBATCH --cpus-per-task=10
+#SBATCH --mem=27G
+#SBATCH --time=14:00:00
+#SBATCH --output=logs/sweep-%j.out
+
+set -uo pipefail
+module load FFmpeg/7.0.2-GCCcore-13.3.0
+export PYTHONPATH="$PWD" PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
+PY=/data/asem.a.abdelaziz/gp-2027a/myenv/bin/python
+OUT=/data/asem.a.abdelaziz/gp-2027a/runs/sweep
+CLIPS=40000
+nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
+# Two jobs starting together can race on mkdir over NFS ("File exists")
+for _ in 1 2 3; do mkdir -p "$OUT" 2>/dev/null && break; sleep 2; done
+[ -d "$OUT" ] || { echo "cannot create $OUT"; exit 1; }
+
+for pair in "$@"; do
+    bs=${pair%%:*}; lr=${pair##*:}
+    name="bs${bs}-lr${lr}"; keep="$OUT/$name"; run="$SCRATCH/$name"
+    if [ -f "$keep/eval_r0.csv" ] && grep -q ",$CLIPS," "$keep/eval_r0.csv"; then
+        echo "=== $name: done, skipping"; continue
+    fi
+    echo "=== $name: start $(date +%T)"
+    mkdir -p "$keep" "$run"
+    $PY scripts/sweep/make_config.py --batch "$bs" --lr "$lr" --clips $CLIPS \
+        --folder "$run" --out "$keep/config.yaml" || continue
+    $PY -m app.main --fname "$keep/config.yaml" --devices cuda:0 > "$keep/train.log" 2>&1
+    cp "$run"/log_r0.csv "$run"/eval_r0.csv "$keep"/ 2>/dev/null
+    rm -rf "$run"
+    grep -q Traceback "$keep/train.log" && echo "=== $name: CRASHED (see $keep/train.log)"
+    echo "=== $name: end $(date +%T)"; tail -n 1 "$keep/eval_r0.csv" 2>/dev/null
+done
-- 
