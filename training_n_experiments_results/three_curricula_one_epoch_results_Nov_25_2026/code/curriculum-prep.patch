+#!/bin/bash
+# Benchmark V-JEPA 2.1 ViT-B and ViT-L pretraining step time / peak memory on
+# one RTX 3090. Each run is ~40 short iterations reading real clips from NFS.
+# Submit from the repository root:  sbatch scripts/benchmark/bench_3090.sbatch
+#SBATCH --job-name=vjepa-bench-3090
+#SBATCH --partition=debug
+#SBATCH --gres=gpu:rtx3090:1
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=48G
+#SBATCH --time=00:30:00
+#SBATCH --output=logs/bench-3090-%j.out
+
+set -euo pipefail
+
+module load FFmpeg/7.0.2-GCCcore-13.3.0
+PY=/data/asem.a.abdelaziz/gp-2027a/myenv/bin/python
